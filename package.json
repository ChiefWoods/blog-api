{
  "name": "blog-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build --no-cache --progress=plain -t blog-api:local .",
    "docker:db:up": "docker compose up -d db",
    "docker:db:start": "docker compose start db",
    "docker:db:stop": "docker compose stop db",
    "docker:db:down": "docker compose down",
    "docker:test-db:up": "docker compose --profile test up -d test-db",
    "docker:test-db:start": "docker compose start test-db",
    "docker:test-db:stop": "docker compose stop test-db",
    "docker:test-db:down": "docker compose --profile test down",
    "docker:test-db:reset": "docker compose --profile test down -v",
    "db:migrate": "bunx --bun prisma migrate dev --name init",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@lexical/code": "^0.44.0",
    "@lexical/code-prism": "^0.44.0",
    "@lexical/code-shiki": "^0.44.0",
    "@lexical/extension": "^0.44.0",
    "@lexical/file": "^0.44.0",
    "@lexical/hashtag": "^0.44.0",
    "@lexical/headless": "^0.44.0",
    "@lexical/html": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/overflow": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@lexical/text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "html-react-parser": "^6.1.0",
    "input-otp": "^1.4.2",
    "isomorphic-dompurify": "^3.12.0",
    "lexical": "^0.44.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.14.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
